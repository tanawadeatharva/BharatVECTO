	<xs:group name="GeneralVehicleOutputGroup">
		<xs:sequence>
			<xs:element name="Model" type="v1.0:ModelType">
				<xs:annotation>
					<xs:documentation>1.1.2. Vehicle model/Commercial Name</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VIN" type="v1.0:VINType">
