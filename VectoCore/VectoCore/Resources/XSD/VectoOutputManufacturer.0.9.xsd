				</xs:annotation>
			</xs:element>
			<xs:element name="HybridElectricHDV" type="v1.0:HybridElectricHDVType">
				<xs:annotation>
					<xs:documentation>1.1.11 Hyprid electric heavy-duty vehicle</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:group>
