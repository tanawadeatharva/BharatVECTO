		<xs:sequence>
			<xs:group ref="mrf:ManufacturerGroup"/>
			<xs:group ref="mrf:GeneralVehicleOutputGroup"/>
			<xs:element name="CO2StandardGroup" minOccurs="0">
				<xs:annotation>
